# Copy this file to .env for docker compose. Never commit real secrets.
#   copy .env.example .env

# --- MySQL (compose service "mysql") ---
MYSQL_ROOT_PASSWORD=darukaa_root_dev
MYSQL_DATABASE=darukaa_earth
MYSQL_USER=darukaa
MYSQL_PASSWORD=darukaa_dev
MYSQL_PORT=3306

# --- Backend ---
# Generate a long random value before any shared/demo deploy.
JWT_SECRET=change-me-in-production
JWT_EXPIRATION_MS=86400000
JWT_FAIL_ON_WEAK_SECRET=false

APP_ADMIN_EMAIL=admin@darukaa.earth
APP_ADMIN_PASSWORD=ChangeMe_Admin_123!
APP_SEED_DEMO=true

# Optional JVM flags for the backend container, e.g. -Xms256m -Xmx512m
JAVA_OPTS=

# Published ports. Frontend nginx listens on 80 inside the container.
FRONTEND_PORT=5173
BACKEND_PORT=8080

# --- Frontend image build (Vite inlines these at `docker compose build`) ---
# Same-origin: browser calls /api on port 5173; nginx proxies to backend:8080.
# Do not set this to http://localhost:8080 for the compose image.
VITE_API_BASE_URL=/api
# Public Mapbox token (pk.*). Required for the map. Rebuild frontend after changing.
VITE_MAPBOX_TOKEN=your_mapbox_public_token
