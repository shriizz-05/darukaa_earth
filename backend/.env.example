# Copy to backend/.env or export as environment variables.
# Spring Boot reads these via application.yml placeholders.
# Never commit a real .env file.

SERVER_PORT=8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Used from Phase 2 onward. Local defaults match docker-compose.yml.
# Compose sets MYSQL_HOST=mysql for the backend container.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=darukaa_earth
MYSQL_USER=darukaa
MYSQL_PASSWORD=darukaa_dev

# JWT (Phase 3). Generate a long random value for any shared/demo deploy.
# Local default matches application.yml. Set JWT_FAIL_ON_WEAK_SECRET=true in production-like environments.
JWT_SECRET=8f3a91c7e2b54d8a6f1c9e7b3a5d2f8c0e4a6b9d1f7c3
JWT_EXPIRATION_MS=86400000
JWT_FAIL_ON_WEAK_SECRET=false

# DEV seed admin created on startup if the email is missing (APP_ADMIN_SEED=true).
# Default password below is for local demo only — change it.
APP_ADMIN_SEED=true
APP_ADMIN_EMAIL=admin@darukaa.earth
APP_ADMIN_PASSWORD=ChangeMe_Admin_123!
